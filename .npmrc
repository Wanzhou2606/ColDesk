# 依赖下载源：默认 registry 直连在部分网络下频繁 ECONNRESET。
# electron 的二进制不走 npm registry，需要单独的镜像变量。
registry=https://registry.npmjs.org/
electron_mirror=https://npmmirror.com/mirrors/electron/
electron_builder_binaries_mirror=https://npmmirror.com/mirrors/electron-builder-binaries/

# 注：这里曾尝试用 verify-deps-before-run / confirm-modules-purge 来规避
# "pnpm 想做依赖检查但在无 TTY 环境中止"的问题，但 pnpm 11 不认这些键名（实测无效），
# 已移除。正确做法是让 pnpm 自己把 node_modules 修好一次，见接手指南 6.14：
#   pnpm install --offline --config.confirm-modules-purge=false
